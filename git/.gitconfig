[init]
	defaultBranch = main

[pull]
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

[core]
	autocrlf = input

[color]
	ui = auto
[user]
	name = Sahil Ashar
	email = sahilashar16@gmail.com

# Machine-local overrides (untracked): URL rewrites, secrets, etc.
# Silently skipped if the file does not exist (e.g. a personal machine).
[include]
	path = ~/.gitconfig.local
